{
  "manifest_version": 2,
  "name": "StreamCatch Media Detector",
  "version": "1.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "streamcatch-media@local"
    }
  },
  "permissions": [
    "webRequest",
    "tabs",
    "nativeMessaging",
    "geckoViewAddons",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
